{
  "name": "job-helper",
  "version": "0.5.1",
  "private": true,
  "description": "ApplyBuddy: an ADHD-friendly Chrome extension that autofills job applications from your local profile. You review and submit.",
  "type": "module",
  "scripts": {
    "build": "vite build && vite build --config vite.content.config.ts",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icons": "python3 scripts/make_icons.py",
    "test:e2e": "node tests/e2e/run.mjs",
    "dev:content": "vite build --watch --config vite.content.config.ts"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "jsdom": "^29.1.1",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "lucide": "^1.65.0",
    "pdfjs-dist": "^6.4.299"
  }
}
