{
  "manifest_version": 3,
  "name": "Job Helper",
  "version": "0.3.0",
  "description": "Fills repetitive job application fields from your local profile. You review and click Submit yourself.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Job Helper",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "options_page": "src/options/index.html",
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": ["storage", "sidePanel", "scripting", "tabs", "unlimitedStorage"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "fill-current-page": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Fill the application form on the current page"
    }
  }
}
